# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (used for Paystack callback). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing or changing this makes existing chat history unreadable.
MESSAGE_ENCRYPTION_KEY=

# LLM. Use LLM_PROVIDER=mock for local development without a key.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# See README → Cost control before choosing. claude-haiku-5-5 is far cheaper.
LLM_MODEL=claude-opus-5-5
# Background work (memory extraction). Defaults to LLM_MODEL.
LLM_UTILITY_MODEL=

# Payments: "bachs" (default) or "paystack". See README → Payment providers.
PAYMENT_PROVIDER=bachs
# Bachs → Developers. Sandbox: https://sandbox-api.bachs.io with sk_sandbox_ keys.
# Live: https://api.bachs.io with sk_live_ keys.
BACHS_API_URL=https://sandbox-api.bachs.io
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=

# Only needed with PAYMENT_PROVIDER=paystack.
PAYSTACK_SECRET_KEY=

# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=
# Exchange rate used to show AI costs in Naira on /admin.
NGN_PER_USD=1500
